<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows TFM required for the Windows.UI.Input.Inking WinRT projections.
         10.0.19041.0 is the minimum SDK that exposes the ink analysis APIs we need. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- SupportedOSPlatformVersion can be lower than the target SDK; keep it at
         the floor that still has InkAnalyzer available. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InkSpike</AssemblyName>
    <RootNamespace>InkSpike</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
